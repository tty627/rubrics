# LLM 调用缓存，体积大且可重建
cache/
*.cache

# 中间产物与最终交付的 xlsx，不入库
data/
outputs/
logs/
*.xlsx
!docs/**/*.xlsx

# 流水线运行态
.pipeline_state.json

# 模型端点配置含 api_key，不入库。用通配盖住 .bak/.old 等副本
config/models.json
config/models.json.*
!config/models.json.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器与系统
.DS_Store
*.swp
.idea/
.vscode/

#监控面板
.tools/